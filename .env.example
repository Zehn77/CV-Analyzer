# ─── NextAuth.js ─────────────────────────────────────────────────────────────

# The canonical URL of your application (used for OAuth callbacks and redirects)
# In production, replace with your actual domain (e.g. https://yourdomain.com)
NEXTAUTH_URL=https://yourdomain.com

# A random secret used to encrypt NextAuth.js session tokens and cookies
# Generate a strong value with: openssl rand -base64 32
NEXTAUTH_SECRET=your-strong-secret-here

# ─── API ─────────────────────────────────────────────────────────────────────

# Base URL of the backend API — exposed to the browser (NEXT_PUBLIC_ prefix)
# Change to your production API URL when deploying
NEXT_PUBLIC_API_URL=https://your-api-url.com
